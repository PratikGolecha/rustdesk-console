# Server Configuration
# PORT=3000

# JWT Configuration
# JWT_SECRET=rustdesk-api-secret-key-change-in-production

# Data Directory (unified storage for database and build artifacts)
# Both the SQLite database and Nexus build artifacts are stored here.
# Only used when DB_TYPE=sqlite.
# DATA_DIR=./data

# Database Type (sqlite | mysql, default: sqlite)
# DB_TYPE=sqlite

# MySQL Configuration (only used when DB_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=rustdesk_console

# Browser (web) client bootstrap - see the web UI repo's docs/WEB-CLIENT.md
# WEB_CLIENT_ENABLED=true
# WEB_CLIENT_ID_SERVER=rd.example.com:21116   # default: hostname of the request
# WEB_CLIENT_API_SERVER=https://rd.example.com # default: origin of the request
# WEB_CLIENT_KEY=                              # server public key, or:
# RUSTDESK_KEY_FILE=/data/id_ed25519.pub
